---
import { profile } from '../data/profile';
---
<section id="projects" class="section">
  <div class="container">
    <h2 class="section-title reveal">Projects</h2>
    <ul class="grid" role="list">
      {profile.projects.map((p) => (
        <li class="card project reveal">
          <div class="head">
            <h3>{p.name}</h3>
            <span class="year">{p.period}</span>
          </div>
          <p>{p.summary}</p>
          <ul class="tags" role="list" aria-label="Tech stack">
            {p.stack.map((t) => <li class="tag">{t}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { margin: 0; padding: 0; display: grid; gap: 1rem; }
  .project { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; transition: border-color 0.2s ease, transform 0.2s var(--ease-out); }
  .project:hover { border-color: var(--border-strong); transform: translateY(-3px); }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  h3 { font-size: 1.125rem; font-weight: 650; }
  .year { font-size: 0.9375rem; color: var(--subtle); }
  p { color: var(--muted); flex: 1; }
  .tags { margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }

  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
