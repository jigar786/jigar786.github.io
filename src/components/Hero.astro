---
import { profile } from '../data/profile';
const current = profile.experience[0];
---
<section id="top" class="hero">
  <div class="container">
    <p class="pill rise" style="--i:0"><span class="dot" aria-hidden="true"></span>{profile.availability}</p>
    <h1 class="rise" style="--i:1">
      {profile.headline.lead}{' '}
      <span class="sr-only">{profile.headline.accent}.</span>
      <span class="rotator" data-rotate={JSON.stringify(profile.headline.rotating)} aria-hidden="true">
        {profile.headline.rotating.map((phrase) => <span class="sizer">{phrase}.</span>)}
        <span class="line"><span class="typed">{profile.headline.accent}</span><span class="caret"></span>.</span>
      </span>
    </h1>
    <p class="intro rise" style="--i:2">{profile.intro}</p>
    <div class="actions rise" style="--i:3">
      <a class="btn btn-primary" href="#contact">Get in touch <span aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href={profile.resumeUrl} download>Download résumé</a>
    </div>
    <ul class="meta rise" style="--i:4" role="list">
      <li>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
        {profile.title}
      </li>
      <li>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
        {profile.location}
      </li>
      <li>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" /><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" /><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" /><path d="M10 6h4M10 10h4M10 14h4M10 18h4" /></svg>
        <span>Currently at <strong>{current.company}</strong></span>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero { padding-block: clamp(3rem, 9vw, 6rem) clamp(2.5rem, 6vw, 4rem); }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--pill-border);
    border-radius: 999px;
    background: var(--pill-bg);
    color: var(--pill-text);
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 25%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot { animation: pulse 2.4s ease-out infinite; }
  }
  h1 {
    font-size: clamp(2.125rem, 1.4rem + 4.2vw, 4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 700;
    max-width: 24ch;
    margin-bottom: 1rem;
    text-wrap: balance;
  }
  .rotator { display: grid; }
  .rotator > * { grid-area: 1 / 1; }
  .sizer { visibility: hidden; }
  .typed { color: var(--accent); }
  .caret {
    display: none;
    width: 0.08em;
    height: 0.85em;
    margin-left: 0.06em;
    background: var(--accent);
    vertical-align: -0.06em;
    border-radius: 1px;
  }
  .rotator:global(.is-typing) .caret { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) {
    .caret { animation: blink 1s steps(1) infinite; }
  }
  .intro {
    color: var(--muted);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    max-width: 58ch;
    margin-bottom: 1.75rem;
  }
  .actions { display: grid; gap: 0.75rem; margin-bottom: 1.75rem; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    margin: 0;
    padding: 0;
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
  }
  .meta li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .meta svg { color: var(--accent); flex-shrink: 0; }
  .meta strong { color: var(--text); font-weight: 650; }

  @media (min-width: 480px) {
    .actions { display: flex; flex-wrap: wrap; }
  }
</style>
