---
import { profile } from '../data/profile';
---
<section id="skills" class="section">
  <div class="container">
    <h2 class="section-title reveal">Skills</h2>
    <div class="grid">
      {profile.skills.map((g) => (
        <div class="group reveal">
          <h3>{g.group}</h3>
          <ul class="tags" role="list">
            {g.items.map((s) => <li class="tag">{s}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 1.75rem; }
  h3 { font-size: 1rem; font-weight: 600; color: var(--text); margin-bottom: 0.75rem; }
  .tags { margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tags :global(.tag) { color: var(--text); font-size: 0.875rem; padding: 0.3rem 0.75rem; }

  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
