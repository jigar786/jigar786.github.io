---
import { profile } from '../data/profile';
---
<section id="recognition" class="section">
  <div class="container grid">
    <div>
      <h2 class="section-title reveal">Awards</h2>
      <ul class="list reveal" role="list">
        {profile.achievements.map((a) => <li>{a}</li>)}
      </ul>
    </div>
    <div>
      <h2 class="section-title reveal">Education</h2>
      <ul class="list edu reveal" role="list">
        {profile.education.map((e) => (
          <li>
            <h3>{e.school}</h3>
            <p>{e.degree} · {e.score}</p>
            <p class="dates">{e.period}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 2.5rem; }
  .list { margin: 0; padding: 0; display: grid; gap: 0; }
  .list > li { padding-block: 0.9rem; border-top: 1px solid var(--border); color: var(--muted); }
  .list > li:last-child { border-bottom: 1px solid var(--border); }
  h3 { font-size: 1rem; font-weight: 600; color: var(--text); margin-bottom: 0.15rem; }
  .dates { font-size: 0.9375rem; color: var(--subtle); }

  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rem; }
  }
</style>
