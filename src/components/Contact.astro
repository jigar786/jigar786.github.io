---
import { profile } from '../data/profile';
const year = new Date().getFullYear();

const linkedin = profile.links.find((l) => l.label === 'LinkedIn')!;
const github = profile.links.find((l) => l.label === 'GitHub')!;

const contacts = [
  { label: 'Email', href: `mailto:${profile.email}`, icon: 'mail' },
  { label: 'LinkedIn', href: linkedin.href, icon: 'linkedin', external: true },
  { label: 'GitHub', href: github.href, icon: 'github', external: true },
];
---
<section id="contact" class="section contact">
  <div class="container">
    <h2 class="section-title reveal">Contact</h2>
    <p class="note">{profile.openToRoles}</p>

    <ul class="icons reveal" role="list">
      {contacts.map((c) => (
        <li>
          <a
            class="icon-btn"
            href={c.href}
            aria-label={c.label}
            title={c.label}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener' : undefined}
          >
            {c.icon === 'mail' && (
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
            )}
            {c.icon === 'linkedin' && (
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
            )}
            {c.icon === 'github' && (
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <span>© {year} {profile.name}</span>
  </div>
</footer>

<style>
  .contact { padding-bottom: clamp(3.5rem, 8vw, 5.5rem); }
  .note { color: var(--muted); font-size: 1.0625rem; max-width: 52ch; margin-bottom: 1.5rem; }

  .icons { margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--surface);
    color: var(--muted);
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .icon-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.75rem;
    border-top: 1px solid;
    border-image: linear-gradient(90deg, transparent, var(--border-strong), transparent) 1;
    font-size: 0.875rem;
    color: var(--subtle);
  }
</style>
