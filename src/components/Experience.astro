---
import { profile } from '../data/profile';
---
<section id="experience" class="section">
  <div class="container">
    <h2 class="section-title reveal">Experience</h2>

    <ol class="timeline" role="list">
      {profile.experience.map((job) => (
        <li class="job reveal">
          <div class="job-head">
            <h3>{job.company}</h3>
            <p class="role">{job.role}</p>
            <p class="dates">{job.start} – {job.end}</p>
          </div>
          <ul class="highlights">
            {job.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline { margin: 0; padding: 0; display: grid; gap: 0; }
  .job {
    position: relative;
    padding: 0 0 2rem 1.75rem;
    border-left: 1px solid var(--border-strong);
  }
  .job:last-child { padding-bottom: 0; border-left-color: transparent; }
  .job::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0.45rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }
  .job:first-child::before { background: var(--accent); }
  .job-head { margin-bottom: 0.85rem; }
  h3 { font-size: 1.25rem; font-weight: 650; letter-spacing: -0.01em; line-height: 1.3; }
  .role { color: var(--muted); }
  .dates { font-size: 0.9375rem; color: var(--subtle); margin-top: 0.15rem; font-variant-numeric: tabular-nums; }
  .highlights {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
    color: var(--muted);
    max-width: 70ch;
  }
  .highlights li::marker { color: var(--accent); }

  @media (min-width: 720px) {
    .job-head {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 1rem;
      align-items: baseline;
    }
    .role { grid-column: 1; }
    .dates { grid-column: 2; grid-row: 1; margin-top: 0; }
  }
</style>
